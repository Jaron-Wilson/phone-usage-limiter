<resources>
    <style name="Theme.Modes" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#17150F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Pure black, no wallpaper. The wallpaper is the first thing on a phone
         designed to pull your eye; a home screen for putting the phone down
         should not have one. -->
    <style name="Theme.Modes.Launcher" parent="Theme.Modes">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
